{
  "manifest_version": 3,
  "name": "Exam Tab",
  "description": "A calm new tab with a countdown to your next exam.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "settings/index.html",
    "open_in_tab": true
  }
}
